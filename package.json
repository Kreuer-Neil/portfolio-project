{
  "name": "portfolio-project",
  "version": "1.0.0",
  "description": "For WP portfolio theme",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "chokidar './wp-content/themes/portfolio/ressources/js/app/**/*.js' './wp-content/themes/portfolio/ressources/css/**/*' -c 'vite build'",
    "serve": "browser-sync start --proxy 'http://portfolio-project.test' --files 'wp-content/themes/portfolio/public/**/*' --no-https --port 3000"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "browser-sync": "^3.0.3",
    "chokidar-cli": "^3.0.0",
    "glob": "^11.0.1",
    "sass": "^1.86.0",
    "vite": "^6.2.2"
  }
}
